namespace source_cache;

struct Span { start:uint; end:uint; }
// Big-endian XXH3-128, for corruption detection rather than authentication.
struct Hash128 { bytes:[ubyte:16]; }
struct Fingerprint { bytes:[ubyte:16]; }
struct ParserConfig {
  typescript:bool;
  jsx:bool;
  definition:bool;
  commonjs:bool;
  detect_esm:bool;
}

// No sentinel: byte offset/ID zero is a real identity.
table OptionalIndex { value:uint = null; }
