include "module.fbs";
namespace source_cache;

table SourceProvenance {
  source_hash:Hash128 (required);
  config:ParserConfig (required);
  records_hash:Hash128 (required);
}
table CacheRecord {
  schema:uint;
  extractor:uint;
  oxc:string (required);
  source_len:ulong;
  source_hash:Hash128 (required);
  config:ParserConfig (required);
  // A typed nested FlatBuffer, not a serialized DTO or CBOR payload. The exact
  // Immutable module bytes are the extraction seal's XXH3-128 input.
  module:[ubyte] (required, nested_flatbuffer: "CachedModule");
  provenance:SourceProvenance (required);
}

table MapSource {
  original:string (required);
  url:string (required);
  content:string;
}
struct MapToken {
  generated_line:uint;
  generated_column:uint;
  original_line:uint;
  original_column:uint;
  source:int;
  name:int;
}
// Separately sealed output-only metadata; changes never invalidate JS extraction.
table UpstreamMap {
  schema:uint;
  extractor:uint;
  source_hash:Hash128 (required);
  input_hash:Hash128 (required);
  location:string (required);
  file:string;
  source_root:string;
  sources:[MapSource] (required);
  names:[string] (required);
  tokens:[MapToken] (required);
}
root_type CacheRecord;
file_identifier "GFSC";
file_extension "seg.fb";
